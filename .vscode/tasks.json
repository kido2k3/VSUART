
    {
  "version": "2.0.0",
  "inputs": [
    { "id": "filelist", "type": "promptString", "description": "Filelist", "default": "filelist.f" },
    { "id": "top",      "type": "promptString", "description": "Top module", "default": "tb_top" },
    { "id": "mode",     "type": "pickString",   "description": "Mode", "options": ["cli", "gui"], "default": "cli" },
    { "id": "uvm",      "type": "pickString",   "description": "UVM?", "options": ["uvm", "no"], "default": "uvm" }
  ],
  "tasks": [
    {
      "label": "Questa: run",
      "type": "shell",
      "command": "${workspaceFolder}\\run_sim.bat",
      "args": ["${input:filelist}", "${input:top}", "${input:mode}", "${input:uvm}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}